# Copy this file to ".env" and fill in the values you need.
# ".env" is git-ignored and is loaded by docker-compose (env_file: .env).
#
# Any setting from web/appsettings.json can be overridden here using the
# ASP.NET Core convention of "__" (double underscore) as the section separator,
# e.g. "AiGateway:BaseUrl" -> "AiGateway__BaseUrl".

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# ---------------------------------------------------------------------------
# AppSettings
# ---------------------------------------------------------------------------
AppSettings__SiteName=LectureVault
# AppSettings__SiteLogo=/images/logo.png
# Set to "true" to allow self-service registration; the first user always
# becomes Developer via the /Setup/FirstUser flow regardless of this setting.
AppSettings__AllowPublicRegistration=false
# Light | Dark | System
AppSettings__DefaultThemeMode=System

# ---------------------------------------------------------------------------
# AiGateway (OpenAI-compatible chat/TTS/STT gateway) — leave blank to disable
# ---------------------------------------------------------------------------
AiGateway__BaseUrl=https://ai.ramskov.pro
AiGateway__ApiKey=
AiGateway__DefaultChatModel=gemma4:12b
AiGateway__DefaultLanguage=Dansk
AiGateway__DefaultTtsModel=speaches-ai/piper-da_DK-talesyntese-medium
AiGateway__DefaultTtsVoice=talesyntese
AiGateway__DefaultSttModel=Systran/faster-whisper-small
AiGateway__RequestTimeoutSeconds=3700

# ---------------------------------------------------------------------------
# Ollama — leave blank to disable
# ---------------------------------------------------------------------------
Ollama__BaseUrl=
Ollama__ApiKey=
Ollama__DefaultChatModel=
Ollama__DefaultGenerateModel=
Ollama__DefaultEmbeddingModel=
Ollama__DefaultKeepAlive=
Ollama__DefaultLanguage=Dansk
Ollama__UseStreamingByDefault=false
Ollama__RequestTimeoutSeconds=600

# ---------------------------------------------------------------------------
# Sms — leave BaseUrl/ApiKey blank to keep the SmsWorker disabled
# ---------------------------------------------------------------------------
Sms__BaseUrl=
Sms__ApiKey=
Sms__WorkerIntervalSeconds=30

# ---------------------------------------------------------------------------
# Mail (SMTP send / IMAP read) — leave blank to disable
# ---------------------------------------------------------------------------
Mail__Smtp__Host=
Mail__Smtp__Port=587
Mail__Smtp__SecureSocketOptions=StartTls
Mail__Smtp__Username=
Mail__Smtp__Password=
Mail__Smtp__FromAddress=
Mail__Smtp__FromName=

Mail__Imap__Host=
Mail__Imap__Port=993
Mail__Imap__SecureSocketOptions=SslOnConnect
Mail__Imap__Username=
Mail__Imap__Password=
