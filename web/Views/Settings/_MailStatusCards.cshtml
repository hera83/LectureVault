@model web.ViewModels.MailSettingsViewModel

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi @(Model.IsOnline ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") fs-3"></i>
                <div>
                    <div class="mail-card-label">@(Model.IsOnline ? "Online" : "Offline")</div>
                    <div class="text-muted small">
                        @if (!Model.IsOnline)
                        {
                            <text>@(Model.ErrorMessage ?? "Kunne ikke forbinde til mailboksen.")</text>
                        }
                        else
                        {
                            <text>Mailboks (IMAP)</text>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="mail-card-label mb-1">Mails i indbakke</div>
                <div class="text-muted small">@Model.TotalMessageCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="mail-card-label mb-1">Ulæste mails</div>
                <div class="text-muted small">@Model.UnseenMessageCount</div>
            </div>
        </div>
    </div>
</div>
