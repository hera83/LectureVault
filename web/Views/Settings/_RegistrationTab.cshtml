@model web.ViewModels.RegistrationSettingsViewModel

<form asp-action="UpdateRegistration" method="post" id="registrationForm">
    @Html.AntiForgeryToken()
    <div class="settings-option">
        <div class="settings-option-icon">
            <i class="bi bi-person-plus"></i>
        </div>
        <div class="settings-option-body">
            <div class="form-check form-switch">
                <input asp-for="AllowPublicRegistration" class="form-check-input" role="switch" />
                <label asp-for="AllowPublicRegistration" class="form-check-label">Tillad offentlig brugertilmelding fra login siden</label>
            </div>
            <p class="settings-option-hint">
                <i class="bi bi-info-circle me-1"></i>
                Standard er deaktiveret. Når funktionen er deaktiveret, kan kun administratorer oprette brugere.
            </p>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-3">
        <i class="bi bi-floppy2 me-1"></i> Gem
    </button>
</form>

<script>
    (() => {
        const form = document.getElementById('registrationForm');
        form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;
            await window.FvForm.submit(form);
            if (submitBtn) submitBtn.disabled = false;
        });
    })();
</script>
